# PhantomProbe Environment Configuration

# Dashboard Configuration
PHANTOMPROBE_DASHBOARD_HOST=127.0.0.1
PHANTOMPROBE_DASHBOARD_PORT=8080

# Burp Suite Integration
BURP_API_URL=http://127.0.0.1:1337
BURP_API_KEY=your-burp-api-key-here

# Playwright Configuration
# Where Playwright looks for downloaded browsers. Leave unset to use the
# default shared cache (~/.cache/ms-playwright); set to 0 to keep them inside
# the installed playwright package instead. The Docker full image sets this
# itself, so override it only if you know you need to.
# PLAYWRIGHT_BROWSERS_PATH=

# CVE API (NVD API)
NVD_API_KEY=your-nvd-api-key-here
# Get yours at: https://nvd.nist.gov/developers/request-an-api-key
